{
  "name": "kovan",
  "productName": "Kovan",
  "version": "1.0.0",
  "description": "Kovan - topluluklar, kanallar ve gerçek zamanlı sohbet",
  "author": "Xanaphian",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "release": "npm run build && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.22",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  }
}
