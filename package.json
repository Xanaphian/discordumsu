{
  "name": "kovan",
  "productName": "Kovan",
  "version": "1.71.2",
  "description": "Kovan - topluluklar, kanallar ve gerçek zamanlı sohbet",
  "author": "Xanaphian",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "test": "npm run test:surum && npm run build:server && npm run test:sunucu",
    "test:sunucu": "node --test --test-reporter=spec \"test/sunucu/*.test.mjs\"",
    "test:surum": "node test/surum/surum.mjs",
    "test:duman": "node test/duman/duman.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "build:mobil": "vite build --config vite.mobil.config.mts",
    "mobil:android": "npm run build:mobil && cap sync android",
    "mobil:ios": "npm run build:mobil && cap sync ios"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "qrcode-generator": "^2.0.4",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.181.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@workadventure/noise-suppression": "0.2.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.22",
    "three": "^0.181.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  }
}
